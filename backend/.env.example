# Copy to `.env` for local development. Never commit real secrets.

DATABASE_URL=postgresql+psycopg://sinaliza:sinaliza@localhost:5432/sinaliza
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRE_MINUTES=60

# Dev-only seed user (used by `python -m app.infrastructure.db.seed_dev_user`).
# There is no self-service registration screen — this is the only user.
DEV_SEED_NAME=Coordenação Pedagógica
DEV_SEED_EMAIL=coordenacao@sinaliza.dev
DEV_SEED_PASSWORD=change-me

# Used only by the test suite (backend/tests) — a separate database/instance
# from DATABASE_URL above, never the dev database.
TEST_DATABASE_URL=postgresql+psycopg://sinaliza:sinaliza@localhost:5433/sinaliza_test

# Default rolling-window size (days) for GET /students/{id}/trajectory.
# TRAJECTORY_WINDOW_DAYS=30

# Rehearsal mechanism for the live demonstration (app.domain.as_of.as_of) —
# never a product feature. Set to an ISO-8601 date (e.g. 2026-09-24) before
# starting the backend to pin "today" for a rehearsal/presentation run; every
# EVAL_DEMO read (Home, Trajectory) is truncated to that date, exactly like
# the real deployment truncates to the real UTC date. Leave unset in the real
# deployment. Read fresh on every request — safe to change and restart
# between rehearsal runs. Changing it to an EARLIER date than a prior run
# used is also safe: every live read re-applies the current value, so nothing
# detected/persisted under a later "today" lingers once rewound.
# SINALIZA_DEMO_AS_OF=2026-09-24
